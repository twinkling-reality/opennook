---
import '../styles/landing.css';
import NookShowcase from '../components/landing/NookShowcase.astro';

const repoUrl = 'https://github.com/twinkling-reality/opennook';
const docsUrl = '/start/introduction/';
const startUrl = '/start/install/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <title>OpenNook - Notch apps for macOS</title>
    <meta name="description" content="An open-source Swift framework for building macOS notch apps." />
    <meta property="og:title" content="OpenNook" />
    <meta property="og:description" content="An open-source Swift framework for building macOS notch apps." />
    <meta property="og:url" content="https://opennook.dev" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://opennook.dev/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://opennook.dev/og-image.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://opennook.dev/" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a href="#copy" class="visually-hidden">Skip to content</a>

    <div class="field" aria-hidden="true"></div>

    <div class="page">
      <!-- The nav lives in a notch: the chrome is the product. -->
      <header class="notchbar">
        <nav class="notchbar__nav" aria-label="Site">
          <span class="notchbar__brand" translate="no">OpenNook</span>
          <span class="notchbar__rule" aria-hidden="true"></span>
          <a class="notchbar__link u-interactive u-wash" href={docsUrl}>Docs</a>
          <a class="notchbar__link u-interactive u-wash" href={repoUrl}>GitHub</a>
        </nav>
      </header>

      <main class="hero">
        <section class="hero__copy" id="copy">
          <h1 class="hero__title">Notch apps for macOS.</h1>
          <p class="hero__tagline">
            An open-source Swift framework for building macOS notch apps.
          </p>
          <a class="hero__cta u-interactive u-lift u-sheen" href={startUrl}>Get started</a>
        </section>

        <NookShowcase />
      </main>
    </div>
  </body>
</html>
